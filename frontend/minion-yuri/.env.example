# Copy to .env.local and change what you need, then restart `npm start`.

# Where the backend runs (default: http://localhost:8000).
# On the deployed site, set this to the backend's public address.
REACT_APP_API_URL=http://localhost:8000

# true = use public/mock/frames.json instead of the backend (works offline).
REACT_APP_USE_MOCK=false
