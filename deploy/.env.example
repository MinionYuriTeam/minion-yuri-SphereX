# Settings for deploy/huggingface/deploy.sh and deploy/precache.sh.
# Copy to deploy/.env and fill in. deploy/.env is git-ignored: never commit it.

# Your Hugging Face username
HF_USERNAME=

# The Space to deploy to: <username>/<space-name>
HF_SPACE=

# Hugging Face access token with WRITE permission
# (https://huggingface.co/settings/tokens). Git uses it as the password:
# Hugging Face no longer accepts your account password for git pushes.
HF_TOKEN=

# Where the deployed backend runs. Leave empty to use the Space's default
# address: https://<username>-<space-name>.hf.space
BACKEND_URL=
